# Copy to .env and fill in real values. Never commit the real .env.
# Every variable here is read somewhere in src/ or knexfile.js - see docs/deployment.md for the full table.

# --- Required ---

# Postgres connection string, read by knexfile.js (Knex is the only DB client - no raw pg pool exists)
DATABASE_URL=postgres://user:password@localhost:5432/revoras

# Signs/verifies every JWT (customer, business, admin) - the one key that, if guessed, lets
# anyone mint a token for any account including a super_admin. GENERATE IT, never type it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# config/secrets.js refuses to boot in production if this is unset, short, or looks like a
# typed phrase rather than a generated key, and warns about it everywhere else.
JWT_SECRET=

# express-session secret (used for the Google OAuth handshake). Same rules as JWT_SECRET, and
# it must be a DIFFERENT value - sharing one key makes a cookie compromise a token compromise.
SESSION_SECRET=

# CORS origin allowlist + used to build links in emails and the Google OAuth redirect.
# Comma-separate to allow more than one origin (e.g. an apex domain and its www host).
# In production this must be set: there is no localhost fallback, the app refuses to boot.
FRONTEND_URL=http://localhost:3000

# How many reverse proxies / load balancers sit in front of this app, as seen by Express's
# `trust proxy` setting. This is a SECURITY setting, not a cosmetic one: every per-IP rate
# limiter reads req.ip, so leaving it at 0 behind a proxy makes every request look like it
# came from the proxy (one shared bucket for the whole internet), while setting it too high
# lets a client forge X-Forwarded-For and evade those limits entirely. Use the exact number
# of proxies you control. 0 = no proxy, direct connections only.
TRUST_PROXY=0

# Gates Knex environment selection (knexfile.js), the email dev-mode fallback (email.service.js),
# and the session cookie's `secure` flag. Set this explicitly to `production` in production -
# leaving it unset does NOT behave the same as `development` for the email fallback.
NODE_ENV=development

# --- Optional ---

# HTTP listen port. Defaults to 5000 if unset.
PORT=5000

# Google OAuth (config/passport.js). Only required if Google login is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Transactional email via the Resend HTTP API (email.service.js). If either is missing:
# - NODE_ENV=production -> sendEmail returns a typed failure, nothing is sent
# - any other NODE_ENV   -> logs "[DEV MODE] Email to ..." to the console instead of sending
# EMAIL_FROM must be a FULL email address on a Resend-verified domain (a bare
# domain like "example.com" is rejected by Resend and every send 502s). A display
# name is optional, e.g. EMAIL_FROM=Revoras <noreply@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# LOCAL DEVELOPMENT ONLY. Returns the signup OTP in the /api/verification/send-verification
# response body, because there is no SMS provider wired up and email is often unconfigured
# locally. Setting this turns email/phone verification into a formality: the caller is handed
# the secret that was supposed to prove they own the address. It is ignored outright when
# NODE_ENV=production, and leaving it unset makes phone OTP sends fail honestly instead of
# reporting a success that never happened. Never set it in a deployment.
AUTH_DEV_ECHO_OTP=false

# Rate limit caps (rateLimit.middleware.js). All optional - leaving them unset
# keeps the production defaults (api: 100/min per USER, flood: 600/min per IP,
# auth: 10 failures per 15 min per ACCOUNT, auth flood: 100 per 15 min per IP,
# register: 10/hour per IP). Raise RATE_LIMIT_API_MAX for browser QA sweeps,
# which burn a page's worth of calls per screen and would otherwise 429 partway
# through a run. RATE_LIMIT_FLOOD_MAX is a per-IP ceiling in front of JWT
# verification, not a usage budget - it must stay well above what a whole
# office or campus behind one NAT does legitimately.
#
# The auth caps count FAILURES only (successes are refunded), so they measure
# guessing rather than traffic - do not lower them to shape normal usage. The
# register cap is the exception and counts every request, because a successful
# signup is what account-spam looks like.
RATE_LIMIT_API_MAX=
RATE_LIMIT_FLOOD_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_AUTH_FLOOD_MAX=
RATE_LIMIT_REGISTER_MAX=

# Payment mode (config/payments.js). "mock" is a TEMPORARY development stand-in: the customer
# clicks Pay and the booking is confirmed instantly, with a payment row written as paid but NO
# money moved - it exists so the booking funnel can be run without live gateway keys. Set to
# "razorpay" (or leave blank once real keys are present) for the real gateway. With
# NODE_ENV=production the app REFUSES TO BOOT in mock mode unless the escape hatch below is
# also set, because a copied .env is the likeliest way this reaches a real deployment.
PAYMENTS_MODE=mock

# Escape hatch for a deliberately non-charging production-flagged environment (staging, demo).
# Only has any effect alongside PAYMENTS_MODE=mock and NODE_ENV=production.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# Razorpay (config/razorpay.js). If either key is missing, payment endpoints return a clean
# 503 "Payments are not configured on this server yet" instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies the server-to-server webhook (POST /api/payments/webhook) via HMAC-SHA256 against
# the raw request body. If unset, the webhook handler returns 503 and logs a warning rather
# than accepting an unverified call.
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 object storage (config/r2.js), consumed only through
# storage/providers/R2StorageProvider.js -> services/media.service.js. If
# any of the first three are missing, R2StorageProvider throws a 503 "Media
# storage is not configured on this server yet" per request rather than
# crashing the whole server on boot.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=revoras
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if unset.
R2_ENDPOINT=
# Public CDN domain object keys are served from - MediaService returns
# `${MEDIA_BASE_URL}/<object-key>` as the URL persisted on records (e.g.
# businesses.logo_url), and derives the object key back out of it for
# delete/replace.
MEDIA_BASE_URL=https://media.uvingroup.xyz
# Per-file upload cap enforced by both the multer middleware and
# MediaService's own validation. Defaults to 5 if unset.
MEDIA_MAX_FILE_SIZE_MB=5

# Redis (config/redis.js), consumed only through cache/providers/RedisCacheProvider.js ->
# cache/index.js. If unset, cache/index.js falls back to InMemoryCacheProvider (per-process,
# no external dependency) - the app never requires Redis to boot or to serve cached data.
REDIS_URL=

# Structured logger verbosity (utils/logger.js). Defaults to "debug" outside production,
# "info" in production. Valid values follow whatever LOG_LEVEL_PRIORITY defines in that file.
LOG_LEVEL=debug

# Only read by knexfile.js's `test` Knex environment; falls back to DATABASE_URL if unset.
TEST_DATABASE_URL=

# Set to the literal string "true" to enable verbose Knex query logging in development.
KNEX_DEBUG=false
